#!/usr/bin/env bash
# pre-push hook: before anything becomes public, scan every commit being
# pushed with gitleaks (redacted) and the commit-message/identity check, and
# run the repository policy on the working tree. Fails closed if gitleaks is
# missing. Install with scripts/install_git_hooks.sh.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
gitleaks_bin="${BOWELNCA_GITLEAKS:-gitleaks}"
command -v "$gitleaks_bin" >/dev/null 2>&1 \
  || { echo "pre-push: gitleaks not found; install it (see SECURITY.md) or set BOWELNCA_GITLEAKS" >&2; exit 1; }
export BOWELNCA_REQUIRE_PRIVATE_PATTERNS="${BOWELNCA_REQUIRE_PRIVATE_PATTERNS:-1}"
zero='0000000000000000000000000000000000000000'
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # branch deletion: nothing new is published
  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes"              # new branch: commits not yet on any remote
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086  # range intentionally splits into rev-list arguments
  if [ -n "$(git rev-list $range)" ]; then
    "$gitleaks_bin" git --redact --no-banner --config "$root/.gitleaks.toml" --log-opts="$range" "$root" || status=1
    # shellcheck disable=SC2086
    bash "$root/scripts/check_commit_messages.sh" $range || status=1
  fi
done
bash "$root/scripts/check_repo_policy.sh" "$root" || status=1
[ "$status" -eq 0 ] || echo "pre-push: blocked; fix the findings above before publishing" >&2
exit "$status"
